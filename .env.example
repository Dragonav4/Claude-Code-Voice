# Environment variables read by the voice-personas plugin.
#
# Copy this file to one of these places and fill in what you need:
#   ~/.claude/voice-personas/.env   recommended: survives plugin updates
#   <plugin folder>/.env            handy when you run the plugin from a clone
# Then run `chmod 600` on it: the plugin logs a warning if others can read it.
#
# Precedence: real environment variables > ~/.claude/voice-personas/.env
# > <plugin folder>/.env > config.json. Empty values are ignored.
# Never commit a real key: `.env` is in .gitignore, this example file is not.

# ElevenLabs API key (elevenlabs.io -> Developers -> API Keys). Needs Text to Speech access.
ELEVENLABS_API_KEY=

# Default ElevenLabs voice ID. Per-persona voices go into config.json ("voices").
ELEVENLABS_VOICE_ID=

# ElevenLabs model. Default: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=

# Where the plugin keeps its state, config, cache and log.
# Default: ~/.claude/voice-personas
VOICE_PERSONAS_HOME=

# Set to 1 to print spoken lines instead of synthesizing and playing them.
VOICE_PERSONAS_DRY_RUN=
