# Environment variables read by the voice-personas plugin.
#
# The plugin does NOT load .env files. Variables must be in the environment that
# Claude Code is started from. Either:
#   - copy the lines you need into your shell profile (~/.zshrc, ~/.bashrc) as
#     `export NAME="value"`, or
#   - use direnv (`direnv allow`) in the folder you start Claude Code from.
# On Windows, set them as user environment variables.
#
# For the API key, ~/.claude/voice-personas/config.json ("api_key") is usually
# more reliable: Claude Code started from tmux or an IDE may not see your shell
# profile. Never put a real key into this file or anywhere in the repository.

# ElevenLabs API key (elevenlabs.io -> Developers -> API Keys). Needs Text to Speech access.
ELEVENLABS_API_KEY=

# Default ElevenLabs voice ID. Per-persona voices go into config.json ("voices").
ELEVENLABS_VOICE_ID=

# ElevenLabs model. Default: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=

# Where the plugin keeps its state, config, cache and log.
# Default: ~/.claude/voice-personas
VOICE_PERSONAS_HOME=

# Set to 1 to print spoken lines instead of synthesizing and playing them.
VOICE_PERSONAS_DRY_RUN=
