{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" \"${CLAUDE_PLUGIN_ROOT}/bin/on_session.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" \"${CLAUDE_PLUGIN_ROOT}/bin/on_prompt.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" \"${CLAUDE_PLUGIN_ROOT}/bin/on_speak.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" \"${CLAUDE_PLUGIN_ROOT}/bin/on_speak.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" \"${CLAUDE_PLUGIN_ROOT}/bin/on_notify.py\""
          }
        ]
      }
    ]
  }
}
